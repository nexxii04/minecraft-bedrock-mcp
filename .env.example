# minecraft-bedrock-mcp configuration
#
# Every setting is an environment variable; nothing is read from files other
# than this one (loaded automatically via dotenv, if present). Values below are
# the defaults, so this file works as-is for a local Bedrock server.
#
# Copy to `.env` and adjust:  cp .env.example .env

# ---------------------------------------------------------------- connection
# Where to connect when a tool does not pass host/port explicitly.
MCBE_HOST=127.0.0.1
MCBE_PORT=19132

# In-game name this agent-player uses.
MCBE_USERNAME=MCPAgent

# `true`  = offline mode: no Xbox Live login, the username is taken at face
#           value. Works on servers with `online-mode=false` (which is what
#           vanilla Bedrock Dedicated Server does by default) and on most test
#           servers. This is the default.
# `false` = Xbox Live device-code login. The server prints a URL and a code to
#           the log; the credential cache lives in MCBE_PROFILES_FOLDER.
MCBE_OFFLINE=true

# Where the Xbox Live token cache is written (only used when MCBE_OFFLINE=false).
MCBE_PROFILES_FOLDER=.minecraft-auth

# Title shown to the player during the Xbox Live sign-in prompt.
# MCBE_AUTH_TITLE=Minecraft Bedrock MCP

# Pin a specific Bedrock release, e.g. 1.21.130. Leave unset to use the version
# `bedrock-protocol` ships with, upgraded automatically by server discovery.
# MCBE_VERSION=

# RakNet transport implementation:
#   jsp-raknet    pure JavaScript, no build toolchain needed (default)
#   raknet-native native addon, lower CPU; requires a compiler at install time
MCBE_RAKNET_BACKEND=jsp-raknet

# Run the RakNet codec in worker threads. Leave on unless you hit a worker limit.
MCBE_USE_RAKNET_WORKERS=true

# Skip the discovery ping and connect straight to the configured port. Useful for
# servers that do not answer pings (proxies, some containers).
MCBE_SKIP_PING=false

# ---------------------------------------------------------------- timeouts (ms)
MCBE_PING_TIMEOUT_MS=2000
MCBE_CONNECT_TIMEOUT_MS=15000
MCBE_SPAWN_TIMEOUT_MS=30000

# Budget for any single action waiting on a server acknowledgement.
MCBE_ACTION_TIMEOUT_MS=5000

# How long send_chat waits for our own message to be echoed back.
MCBE_CHAT_ECHO_TIMEOUT_MS=1500

# Chunk radius requested after joining (also the client view distance).
MCBE_VIEW_DISTANCE=10
MCBE_REQUEST_CHUNK_RADIUS=true

# ---------------------------------------------------------------- reconnection
MCBE_RECONNECT_ENABLED=true

# Reconnect after a server-side kick. On by default because the usual kick during
# testing is "the server is restarting"; set to false where a kick means stop.
MCBE_RECONNECT_ON_KICK=true

MCBE_RECONNECT_MAX_ATTEMPTS=5
MCBE_RECONNECT_BASE_DELAY_MS=1000
MCBE_RECONNECT_MAX_DELAY_MS=30000

# ---------------------------------------------------------------- sessions
# How many agent-players may be connected at once (multi-session QA).
MCBE_MAX_SESSIONS=4

# Session id used when a tool call omits `sessionId`.
MCBE_DEFAULT_SESSION_ID=default

# ---------------------------------------------------------------- memory bounds
MCBE_MAX_CHAT_LOG=200
MCBE_MAX_EVENT_LOG=500
MCBE_MAX_TRACKED_ENTITIES=512
MCBE_MAX_TRACKED_BLOCKS=4096
# Decoded chunk payloads kept for terrain queries (`get_block_at`, `find_block`,
# `get_biome`). A full view radius is a few hundred chunks; the cache evicts the
# ones farthest from the player first, so a long walk forgets where it started.
MCBE_MAX_TRACKED_CHUNKS=1024

# ---------------------------------------------------------------- escape hatch
# Exposes `send_raw_packet`, which writes arbitrary packets to the connection.
# Off by default: getting a packet payload wrong can desynchronise a session.
MCBE_ENABLE_RAW_PACKET_TOOL=false

# ---------------------------------------------------------------- logging
# fatal | error | warn | info | debug | trace | silent
MCBE_LOG_LEVEL=info

# Log every decoded packet at debug level (very noisy, for protocol work).
MCBE_LOG_RAW_PACKETS=false

# ---------------------------------------------------------------- MCP transport
# stdio  : the standard local MCP setup (stdout carries JSON-RPC)
# http   : streamable HTTP, for remote/containerised agents
MCBE_TRANSPORT=stdio

MCBE_HTTP_HOST=127.0.0.1
MCBE_HTTP_PORT=8787
MCBE_HTTP_PATH=/mcp
# Keep per-client sessions alive between HTTP requests.
MCBE_HTTP_STATEFUL=true
